# Copy to .env.local for local dev. Set the same keys in Vercel (Project → Settings → Environment Variables).

# Neon Postgres connection string (pooled, with sslmode=require). Must have the pgvector extension (applied by npm run db:migrate).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# OpenAI API key: embeddings, chat model and Realtime ephemeral tokens (server-side only, never exposed to the browser).
OPENAI_API_KEY=
